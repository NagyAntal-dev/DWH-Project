# ============================================================
# Crypto Data Warehouse — Environment Variables
# ============================================================
# Copy this file:  cp .env.example .env
# Then fill in your CoinGecko API key below.
# ============================================================

# ---------- CoinGecko ----------
COINGECKO_API_KEY=CG-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- OLTP PostgreSQL ----------
OLTP_DB_HOST=oltp-db
OLTP_DB_PORT=5432
OLTP_DB_NAME=crypto_oltp
OLTP_DB_USER=oltp_user
OLTP_DB_PASSWORD=oltp_pass

# ---------- DW PostgreSQL ----------
DW_DB_HOST=dw-db
DW_DB_PORT=5432
DW_DB_NAME=crypto_dw
DW_DB_USER=dw_user
DW_DB_PASSWORD=dw_pass

# ---------- Airflow ----------
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://oltp_user:oltp_pass@oltp-db:5432/airflow_meta
AIRFLOW__CORE__FERNET_KEY=YOUR_FERNET_KEY_HERE
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=true
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
